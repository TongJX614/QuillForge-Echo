# GEWUZAOJING shared LLM connection
SHARED_LLM_PROVIDER=openai-compatible
SHARED_LLM_API_KEY=replace-with-real-secret
SHARED_LLM_BASE_URL=https://api.deepseek.com/v1
ECHO_LLM_SOURCE=shared

# Task models
ECHO_CHAT_MODEL=deepseek-chat
ECHO_QUEST_MODEL=deepseek-chat

# Local services
# Standalone Echo dev default: 5000.
# When Echo is launched by an external orchestrator in fused mode, the launcher
# injects ECHO_PORT=5173 (or the next free port).
ECHO_HOST=127.0.0.1
ECHO_PORT=5000

# To use a separate ECHO API, set the selector to dedicated and uncomment these lines
# ECHO_LLM_PROVIDER=openai-compatible
# ECHO_LLM_API_KEY=replace-with-echo-secret
# ECHO_LLM_BASE_URL=https://echo-provider.example/v1

# Optional: address of an externally running narrative engine. Injected by the
# orchestrator in fused mode; leave unset and the in-game generative entries
# report the engine as unavailable instead of failing.
# NARRATIVE_ENGINE_HOST=127.0.0.1
# NARRATIVE_ENGINE_PORT=8050

# The narrative engine lives outside this repository and reads its own .env;
# its model, image and speech settings do not belong in this file.
