# QuillForge 融合运行配置模板：cp .env.example .env 后填 Key 即可
# 本文件由编排脚本以 shell 方式 source，引用写 ${}；没写的项一律走代码默认值

# ─── 统一接入：Key 只填一次 ───
QIANWEN_API_KEY=replace-with-real-secret
QIANWEN_BASE_URL=https://maas.qianwenaiapi.com

# 文本（千问平台托管；剧本/辩论/小游戏同模型）
DEEPSEEK_API_KEY=${QIANWEN_API_KEY}
DEEPSEEK_BASE_URL=${QIANWEN_BASE_URL}/compatible-mode/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash-1017
SCRIPT_GEN_MODEL=${DEEPSEEK_MODEL}
DEBATE_MODEL=${DEEPSEEK_MODEL}
MINIGAME_MODEL=${DEEPSEEK_MODEL}
# 备选文本模型：主模型不可用时按顺序自动切换（Key/余额错误不切换）
DEEPSEEK_FALLBACK_MODELS=deepseek-v4.1-flash,qwen3.8-flash

# 生图（不配则回退占位图，游戏照常可玩）
IMAGE_API_KEY=${QIANWEN_API_KEY}
IMAGE_BASE_URL=${QIANWEN_BASE_URL}/compatible-mode/v1
IMAGE_MODEL=qwen-image-3.0
# 备选生图模型：主模型报错/超时/未开通时按顺序自动切换
IMAGE_FALLBACK_MODELS=qwen-image-3.0-pro,qwen-image-2.1-pro
# 千问/DashScope 生图默认关闭 prompt_extend（开着单张多耗 70s+）和水印；
# 想恢复服务商默认行为时显式开启：
# IMAGE_PROMPT_EXTEND=true
# IMAGE_WATERMARK=true

# 语音（不配则回退纯文字；音色按性别/年龄自动选）
TTS_API_KEY=${QIANWEN_API_KEY}
TTS_BASE_URL=${QIANWEN_BASE_URL}
TTS_PROTOCOL=dashscope
TTS_MODEL=qwen-audio-3.1-tts-flash
# 平台暂无可用的第二个 SpeechSynthesizer 模型，留空即只用主模型
# TTS_FALLBACK_MODEL=

# ── 服务与项目接入（融合编排必需）──
SERVER_HOST=127.0.0.1
SERVER_PORT=8050
# 逗号分隔的可导入模块名；置空则引擎不接入任何项目
QUILLFORGE_PROJECTS=harness.projects.echo
ECHO_ENABLED=true
ECHO_AUTOSTART=true
ECHO_HOME=projects/echo
ECHO_HOST=127.0.0.1
# 5173 是融合模式端口；ECHO 独立开发用 5000，两者不是同一个默认值
ECHO_PORT=5173
ECHO_PORT_MAX_OFFSET=30
ECHO_LAUNCH_MODE=dev
ECHO_LAUNCH_TIMEOUT=120
WEAVE_GAME_HOME=projects/echo/examples/narrative-demo
