# ══════════════════════════════════════════════════════════
# 融合运行配置（仓库根）
#
# engine/ 与 harness/ 都从这里取值。projects/echo 有它自己的 .env，
# 只放 ECHO 自身的 LLM 与端口配置，两边互不代管。
# ══════════════════════════════════════════════════════════

# ── 引擎：大模型 ──
DEEPSEEK_API_KEY=replace-with-real-secret
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 剧本生成 / 辩论 / 小游戏用轻量模型，与运行时模型分开
SCRIPT_GEN_MODEL=deepseek-v4-flash
DEBATE_MODEL=deepseek-v4-flash
MINIGAME_MODEL=deepseek-v4-flash

# ── 引擎：服务 ──
SERVER_HOST=127.0.0.1
SERVER_PORT=8050
# 设为非空后 /api/* 需要请求头 X-API-Key
QUILLFORGE_API_KEY=

# ── 引擎：生图与语音（可选，不配则自动降级）──
# IMAGE_API_KEY=replace-with-image-secret
# IMAGE_BASE_URL=https://image-provider.example/v1
# IMAGE_MODEL=image-model
# TTS_API_KEY=replace-with-tts-secret
# TTS_BASE_URL=https://tts-provider.example/v1
# TTS_MODEL=tts-model

# ── 项目接入 ──
# 逗号分隔的可导入模块名。留空则引擎不接入任何项目，行为与上游一致。
QUILLFORGE_PROJECTS=harness.projects.echo
# 运行期可写目录（上传、生成图片、生成音频）。留空时编排脚本会指向仓库根 var/。
# 必须是绝对路径。留空即表示交给编排脚本决定，不要写成空值赋值。
# QUILLFORGE_VAR_DIR=/absolute/path/to/var

# ── ECHO 宿主（harness 侧）──
ECHO_ENABLED=true
ECHO_AUTOSTART=true
ECHO_HOME=projects/echo
ECHO_HOST=127.0.0.1
# 5173 是融合模式端口；ECHO 独立开发用的是 5000，两者不是同一个默认值
ECHO_PORT=5173
ECHO_PORT_MAX_OFFSET=30
# dev = tsx 直跑 server/server.ts；prod = 先构建再跑 dist-server/server.js
ECHO_LAUNCH_MODE=dev
ECHO_LAUNCH_TIMEOUT=90
# 留空则自动探测 node
ECHO_NODE=
# 世界编织成品页目录，挂载在引擎的 /weave
WEAVE_GAME_HOME=projects/echo/examples/narrative-demo
